# ================================================
# Plantilla de Variables de Entorno — App Factura
# ================================================
# Copia este archivo como ".env" y completa con tus propias contraseñas.
# ⚠️  NUNCA subas el .env real al repositorio.
# ================================================

# Usuarios del sistema
VITE_USER_ADMIN_PASS=TuContraseñaSegura
VITE_USER_ADMIN_ROLE=admin

VITE_USER_FRAN_PASS=TuContraseñaSegura
VITE_USER_FRAN_ROLE=cajero

VITE_USER_ENGELS_PASS=TuContraseñaSegura
VITE_USER_ENGELS_ROLE=mesero

VITE_USER_SIDNEY_PASS=TuContraseñaSegura
VITE_USER_SIDNEY_ROLE=cocinero

# PINs de acceso rápido
VITE_PIN_ADMIN=TuPIN
VITE_PIN_FRAN=TuPIN
VITE_PIN_ENGELS=TuPIN
VITE_PIN_SIDNEY=TuPIN
